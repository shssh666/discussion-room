#!/bin/sh
# pre-push：推送前校验 package.json 与 package-lock.json 同步
# 背景：PR#8「依赖/lockfile 不同步」双引擎实证（计划表 §2）；CI 的 npm ci 是远端兜底，这里是本地前置闸。
# 启用：git config core.hooksPath .githooks（仓库内文档 README.md 有说明）
echo "[pre-push] lockfile 一致性检查..."
node scripts/check-lockfile.mjs || {
  echo "[pre-push] 阻止推送：请先 npm install 重新生成 lock 并提交，再推送"
  exit 1
}
