{
  "name": "discussion-room",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/server/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build.mjs && node test/app.test.ts",
    "test:e2e": "node scripts/build.mjs && node test/e2e-chat.test.ts",
    "test:e2e:upload": "node scripts/build.mjs && node test/e2e-upload.test.ts",
    "test:e2e:convert": "node scripts/build.mjs && CR_CONVERT_MODE=fake CR_FAKE_DELAY=500 node test/e2e-convert.test.ts",
    "test:e2e:mermaid": "node scripts/build.mjs && node test/e2e-mermaid.test.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/server/index.js"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.0",
    "@fastify/static": "^8.1.0",
    "fastify": "^5.3.0",
    "fastify-plugin": "^5.0.0",
    "mermaid": "^11.4.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.0",
    "eslint": "^9.20.0",
    "prettier": "^3.5.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.24.0"
  }
}
